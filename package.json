{
  "name": "navimow-lawn-mower-card",
  "version": "0.1.0",
  "description": "Home Assistant Lovelace card for lawn_mower entities with animated mower SVG.",
  "type": "module",
  "main": "dist/navimow-lawn-mower-card.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "lawn-mower",
    "navimow",
    "lit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6"
  }
}
