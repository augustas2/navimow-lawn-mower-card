{
    "name": "navimow-lawn-mower-card",
    "version": "1.0.0",
    "description": "Home Assistant Lovelace custom card for Navimow lawn mower entities.",
    "type": "module",
    "main": "dist/navimow-lawn-mower-card.js",
    "module": "dist/navimow-lawn-mower-card.js",
    "exports": {
        ".": "./dist/navimow-lawn-mower-card.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "typecheck": "tsc",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check"
    },
    "keywords": [
        "home-assistant",
        "lovelace",
        "lawn-mower",
        "navimow"
    ],
    "author": "Augustas Čirba",
    "license": "MIT",
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.3",
        "custom-card-helpers": "^2.0.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2"
    }
}
