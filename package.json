{
    "name": "navimow-lawn-mower-card",
    "version": "0.1.0",
    "description": "Home Assistant Lovelace card for lawn_mower entities with animated mower SVG.",
    "type": "module",
    "main": "dist/navimow-lawn-mower-card.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check"
    },
    "keywords": [
        "home-assistant",
        "lovelace",
        "lawn-mower",
        "navimow",
        "lit"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "lit": "3.3.3",
        "custom-card-helpers": "2.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.13.3",
        "eslint": "10.6.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.5",
        "typescript": "5.9.3",
        "typescript-eslint": "8.63.0",
        "vite": "8.1.4"
    }
}
